<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controller.AboutController"
            styleClass="about-root">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="about-scroll">

            <VBox spacing="38" styleClass="about-content">
                <padding>
                    <Insets top="40" right="36" bottom="40" left="48"/>
                </padding>

                <!-- Page heading -->
                <VBox spacing="6" styleClass="about-header">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="About"
                               styleClass="about-main-title"/>

                        <Label text="Natural-Systems-Simulator"
                               styleClass="about-title-accent"/>
                    </HBox>

                    <Label text="A collection of interactive simulations built with Java and Processing."
                           styleClass="about-subtitle"
                           wrapText="true"/>
                </VBox>

                <!-- Application information and disclaimer -->
                <HBox spacing="28"
                      alignment="TOP_LEFT"
                      styleClass="about-details">

                    <!-- Project card -->
                    <VBox spacing="14"
                          HBox.hgrow="ALWAYS"
                          styleClass="info-card project-card">

                        <Label text="Project"
                               styleClass="card-eyebrow"/>

                        <Label text="Natural-Systems-Simulator"
                               styleClass="project-name"
                               wrapText="true"/>

                        <Label text="Version 1.0.0"
                               styleClass="project-version"/>

                        <Region prefHeight="1" styleClass="card-separator"/>

                        <VBox spacing="3" styleClass="author-information">
                            <Label text="Developed by"
                                   styleClass="author-label-muted"/>
                            <Label text="Rafael Dias"
                                   styleClass="author-name"/>
                            <Label text="2026"
                                   styleClass="author-label-muted"/>
                        </VBox>
                    </VBox>

                    <!-- Disclaimer card -->
                    <VBox spacing="10"
                          styleClass="disclaimer-card"
                          minWidth="280"
                          prefWidth="360"
                          maxWidth="400">

                        <Label text="Disclaimer"
                               styleClass="disclaimer-eyebrow"/>

                        <Label text="This application was developed for educational and research purposes. No warranty is provided. Use it at your own risk."
                               styleClass="disclaimer-text"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Technology logos -->
                <VBox spacing="18" styleClass="built-with-section">
                    <Label text="Built with"
                           styleClass="built-with-title"/>

                    <HBox spacing="18"
                          alignment="CENTER_LEFT"
                          styleClass="technology-logos">

                        <VBox styleClass="tech-tile" alignment="CENTER" spacing="8">
                            <ImageView fx:id="javaLogo"
                                       fitWidth="44"
                                       fitHeight="54"
                                       preserveRatio="true"
                                       smooth="true"/>
                            <Label text="Java" styleClass="tech-caption"/>
                        </VBox>

                        <VBox styleClass="tech-tile" alignment="CENTER" spacing="8">
                            <ImageView fx:id="javafxLogo"
                                       fitWidth="62"
                                       fitHeight="54"
                                       preserveRatio="true"
                                       smooth="true"/>
                            <Label text="JavaFX" styleClass="tech-caption"/>
                        </VBox>

                        <VBox styleClass="tech-tile" alignment="CENTER" spacing="8">
                            <ImageView fx:id="processingLogo"
                                       fitWidth="50"
                                       fitHeight="54"
                                       preserveRatio="true"
                                       smooth="true"/>
                            <Label text="Processing" styleClass="tech-caption"/>
                        </VBox>

                        <VBox styleClass="tech-tile" alignment="CENTER" spacing="8">
                            <ImageView fx:id="gradleLogo"
                                       fitWidth="54"
                                       fitHeight="54"
                                       preserveRatio="true"
                                       smooth="true"/>
                            <Label text="Gradle" styleClass="tech-caption"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
