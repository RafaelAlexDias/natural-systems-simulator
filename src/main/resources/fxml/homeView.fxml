<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<!--
    Main layout of the Natural-Systems-Simulator application.
    The BorderPane separates the navigation sidebar from the main content.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controller.HomeController"
            styleClass="app-root">

    <!-- Center area: scrollable main content -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="content-scroll">

            <!-- Main content container with consistent vertical spacing -->
            <VBox spacing="44" styleClass="home-content">

                <!-- Controls the spacing between the content and the container edges -->
                <padding>
                    <Insets top="40" right="32" bottom="32" left="46"/>
                </padding>

                <!-- Page introduction and simulation section -->
                <VBox spacing="10">

                    <!-- Welcome message and application name -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Welcome to"
                               styleClass="main-title"/>

                        <Label text="Natural-Systems-Simulator"
                               styleClass="title-accent"/>
                    </HBox>

                    <!-- Short description of the application's purpose -->
                    <Label text="Explore and run different simulations."
                           styleClass="subtitle"/>

                    <!-- Simulation section: heading and grid -->
                    <VBox spacing="28">

                        <!-- Section heading -->
                        <Label text="Latest Simulations Added"
                               styleClass="section-title"/>

                        <!--
                            Container for simulation cards.
                            The controller fills it with the most recent simulations.
                        -->
                        <TilePane fx:id="simulationGrid"
                                  prefColumns="3"
                                  hgap="28"
                                  vgap="28"
                                  tileAlignment="TOP_LEFT"
                                  styleClass="simulation-grid"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
