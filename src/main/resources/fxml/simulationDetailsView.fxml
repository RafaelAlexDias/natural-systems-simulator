<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controller.SimulationDetailsController"
            styleClass="details-root">

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="details-scroll">

            <VBox spacing="28" styleClass="details-content">
                <padding>
                    <Insets top="20" right="36" bottom="36" left="48"/>
                </padding>

                <!-- Breadcrumb -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Simulations"
                           styleClass="breadcrumb-link"
                           onMouseClicked="#backToSimulations"/>

                    <Label text="&gt;"
                           styleClass="breadcrumb-separator"/>

                    <Label fx:id="breadcrumbName"
                           text="Simulation"
                           styleClass="breadcrumb-current"/>
                </HBox>

                <!-- Simulation header -->
                <HBox spacing="28"
                      alignment="TOP_LEFT"
                      styleClass="details-header">

                    <ImageView fx:id="simulationImage"
                               fitWidth="252"
                               fitHeight="148"
                               preserveRatio="false"
                               smooth="true"
                               styleClass="details-image"/>

                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label fx:id="simulationTitle"
                               text="Simulation"
                               styleClass="details-title"
                               wrapText="true"/>
                    </VBox>

                    <Button fx:id="runButton"
                            text="Run Simulation"
                            styleClass="run-button"
                            onAction="#runSimulation"/>
                </HBox>

                <!-- Description and controls -->
                <VBox spacing="18" styleClass="details-panel">
                    <VBox spacing="5">
                        <Label text="Description"
                               styleClass="details-section-title"/>

                        <Label fx:id="simulationDescription"
                               text="Description of the simulation."
                               styleClass="details-description"
                               wrapText="true"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Controls"
                               styleClass="details-section-title"/>

                        <VBox fx:id="controlsContainer"
                              spacing="5"
                              styleClass="controls-container"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
